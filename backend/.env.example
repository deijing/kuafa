KUAFA_CATSAPI_KEY=your_catsapi_key_here
KUAFA_CATSAPI_BASE=https://catsapi.com/api
KUAFA_CATSAPI_MODEL=gptImage2
KUAFA_COVER_SIZE=1024x1536
KUAFA_COVER_QUALITY=auto

# OpenAI-compatible（推荐 DeepSeek V4 Pro 主观选句）
KUAFA_OPENAI_API_KEY=
KUAFA_OPENAI_BASE_URL=https://api.deepseek.com
KUAFA_OPENAI_MODEL=deepseek-v4-pro
# 思考强度（与 OpenAI GPT reasoning_effort 一一对应）
# none | low | medium | high | xhigh | max
KUAFA_OPENAI_REASONING_EFFORT=medium
